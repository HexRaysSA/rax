  "assumptions": [
    {
      "id": "SV1",
      "assumption": "The explicit MVFR0.ShortVectors=1 profile must implement DDI0406C.d D11 controls and all14 affected forms; default0 keeps its masked controls.",
      "stress_test": "Both encodings/precisions, bank wrapping, scalar/broadcast/alias and every permitted length/stride.",
      "falsification_probe": "One defined vector register result or control read differs from the primary contract.",
      "basis": "Arm DDI0406C.d B4.1.58, B4.1.108 and D11.1-4; inspected retained primary text.",
      "dependent_result": "Selected writable controls and complete fourteen-form bank/stride plan.",
      "status": "confirmed",
      "evidence": [
        "owning-VFP-v6",
        "generator-self-check-v7"
      ]
    },
    {
      "id": "SV2",
      "assumption": "This group keeps the non-trapping profile and existing scalar arithmetic helpers; one vector instruction retires once.",
      "stress_test": "FP flags and zero-retirement denials, private/file continuation before and after vector execution.",
      "falsification_probe": "A vector iteration retires as a separate instruction or a denied operation publishes a partial FP state.",
      "basis": "Existing non-trapping profile and scalar handlers; no new exception-trap fields or asynchronous iterations.",
      "dependent_result": "Scalar arithmetic/status semantics, one retirement and exact private/file continuation.",
      "status": "confirmed",
      "evidence": [
        "focused-backend-v5",
        "focused-VM-files-v5",
        "owning-root-library-v6"
      ]
    },
    {
      "id": "SV3",
      "assumption": "UNPREDICTABLE length/stride combinations use an explicit Undefined admission choice before effects.",
      "stress_test": "Invalid combinations, scalar destinations, false predicates and competing FP access traps.",
      "falsification_probe": "One rejected vector mutates CPU/data or reaches an access trap first.",
      "basis": "D11.2 labels nonpermitted shapes UNPREDICTABLE; A8.8.318/319 require scalar controls. RAX explicitly chooses Undefined.",
      "dependent_result": "Pure admission before access checks and any element effect.",
      "status": "retained",
      "evidence": [
        "focused-vfp-v6",
        "owning-VFP-v6"
      ]
    },
    {
      "id": "SV4",
      "assumption": "QEMU is a calibrated independent model, not an architectural substitute.",
      "stress_test": "Stride, double unary, aliasing and feature/readback controls.",
      "falsification_probe": "QEMU contradicts the primary table; retain disagreement and exclude only that comparison with direct evidence.",
      "basis": "Primary rules outrank implementation models; four calibration probes exposed SP stride and DP unary discrepancies.",
      "dependent_result": "All comparisons retained; primary-derived expectations used for the 200 QEMU disagreements.",
      "status": "revised",
      "evidence": [
        "docs/development/a32-short-vectors/qemu-reference.json"
      ]
    },
    {
      "id": "SV5",
      "assumption": "The selected PE executes overlapping short-vector operands in encoded-element order.",
      "basis": "D11 specifies bank/element selection but does not explicitly specify operand read timing. Independent binary and SP unary QEMU observations support this selection; DP unary model is separately discrepant.",
      "dependent_result": "Five overlap forms in both instruction sets; no operand snapshot.",
      "stress_test": "Forward destructive binary overlap and wrapping unary source/destination alias, full 32-D images.",
      "falsification_probe": "A physical compatible PE or explicit primary ordering rule requires a different defined overlap result.",
      "status": "retained",
      "evidence": [
        "owning-VFP-v6",
        "docs/development/a32-short-vectors/qemu-reference.json"
      ],
      "physical_conformance": "unknown"
    }
  ],
