    {
      "id": "SP1",
      "assumption": "The public backend API permits created native CPUs without configure_cpu_topology",
      "basis": "Vm::create_vcpu and NativeTopology.configured None paths",
      "dependent_result": "Unconfigured-VM shutdown capture is in supported API scope",
