      "status": "confirmed in the recorded stopped-boundary and subsequent-entry scope; asynchronous already-entered SDK CPU behavior remains unverified"
    },
    {
      "id": "SP3",
      "assumption": "A restored explicit power graph must supersede the default all-created-CPUs-on fallback",
      "basis": "GlobalContext.power stores pending transitions and states; capture must preserve it",
      "dependent_result": "Only synthesize fallback power when no graph exists",
      "stress_test": "Restore a pending CPU_OFF then capture before acknowledgement",
      "falsification_probe": "Capture resets states or rejects its own restored graph",
      "status": "confirmed in the recorded stopped-boundary and subsequent-entry scope; asynchronous already-entered SDK CPU behavior remains unverified"
    }
  ],
