+                        cpu.wake();
+                    }
+                    assert!(
+                        matches!(exit(&mut **cpu), VcpuExit::IoOut { port: 0xe9, data } if data == [0x21 + id as u8])
+                    );
+                    let CpuState::X86_64(observed) = cpu.get_state().unwrap() else {
+                        unreachable!()
+                    };
+                    assert_eq!(observed.sregs.cr8, id as u64 + 1);
+                }
+            }
+        }
+    }
+}
