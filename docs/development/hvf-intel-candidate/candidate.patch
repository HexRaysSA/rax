+//! Kernel completion provenance must outlive replacement of terminal records.
+use super::*;
+use crate::vm::vcpu::CheckpointIoState;
+
+#[test]
+#[ignore = "requires physical Linux KVM; selected by KVM CI"]
+fn successive_terminal_imports_cannot_hide_a_native_input_completion_from_active_admission() {
+    for irqchip in [false, true] {
+        for count in [1, 2, 4] {
+            let (source, memory, mut cpus) = graph(count, irqchip);
+            let boundary = source.checkpoint_boundary().unwrap();
+            let active = native(&*source).capture_native_banks(&boundary).unwrap();
+            drop(boundary);
+            for (id, cpu) in cpus.iter_mut().enumerate() {
+                let pc = 0x1000 + id as u64 * 0x100;
+                memory
+                    .memory()
+                    .write_slice(&[0xec, 0xf4], GuestAddress(pc))
+                    .unwrap();
+                let CpuState::X86_64(mut state) = cpu.get_state().unwrap() else {
+                    unreachable!()
+                };
+                state.regs.rip = pc;
+                state.regs.rdx = 0x1234;
+                cpu.set_state(&CpuState::X86_64(state)).unwrap();
+                assert!(matches!(
+                    exit(&mut **cpu),
+                    VcpuExit::IoIn {
+                        port: 0x1234,
+                        size: 1
+                    }
+                ));
+            }
+            native(&*source).memory.power_off().unwrap();
+            let boundary = source.checkpoint_boundary().unwrap();
+            let terminal = native(&*source).capture_native_banks(&boundary).unwrap();
+            let json = serde_json::to_vec(&terminal).unwrap();
+            let binary = crate::codec::serialize(&terminal).unwrap();
+            let mut idle = active.clone();
+            idle.powered_off = true;
+            idle.restore_stored(native(&*source), &boundary).unwrap();
+            idle.restore_stored(native(&*source), &boundary).unwrap();
+            let handles = native(&*source).checkpoint_cpu_handles(&boundary).unwrap();
+            let before: Vec<_> = handles
+                .iter()
+                .map(|core| {
+                    let core = core.lock().unwrap();
+                    assert!(core.native_io_unsettled);
+                    assert!(!core.io.has_native_completion());
+                    core.vcpu_fd.get_regs().unwrap()
+                })
+                .collect();
+            assert!(
+                active
+                    .restore_stored(native(&*source), &boundary)
+                    .unwrap_err()
+                    .to_string()
+                    .contains("fresh native owner")
+            );
+            assert!(native(&*source).memory.powered_off.load(Ordering::Acquire));
+            for (core, before) in handles.iter().zip(before) {
+                assert_eq!(core.lock().unwrap().vcpu_fd.get_regs().unwrap(), before);
+            }
+            drop(boundary);
+            drop(handles);
+            drop(cpus);
+            drop(source);
+            drop(memory);
+
+            for terminal in [
+                serde_json::from_slice::<Image>(&json).unwrap(),
+                crate::codec::deserialize_strict::<Image>(&binary).unwrap(),
+            ] {
+                let (target, memory, mut cpus) = graph(count, irqchip);
+                let boundary = target.checkpoint_boundary().unwrap();
+                terminal
+                    .restore_stored(native(&*target), &boundary)
+                    .unwrap();
+                let handles = native(&*target).checkpoint_cpu_handles(&boundary).unwrap();
+                for core in lock_cpus(native(&*target), &handles).unwrap() {
+                    assert!(!core.native_io_unsettled);
+                    assert!(core.io.has_native_completion());
+                }
+                idle.restore_stored(native(&*target), &boundary).unwrap();
+                active.restore_stored(native(&*target), &boundary).unwrap();
+                for core in &handles {
+                    let mut core = core.lock().unwrap();
+                    let before = core.vcpu_fd.get_regs().unwrap();
+                    core.vcpu_fd.set_kvm_immediate_exit(1);
+                    let result = core.vcpu_fd.run().map(|_| ());
+                    core.vcpu_fd.set_kvm_immediate_exit(0);
+                    assert!(matches!(result, Err(error) if error.errno() == libc::EINTR));
+                    assert_eq!(
+                        core.vcpu_fd.get_regs().unwrap(),
+                        before,
+                        "fresh native owner completed an operation it never issued"
+                    );
+                }
+                drop(boundary);
+                memory
+                    .memory()
+                    .write_slice(
+                        &[0xc6, 0x06, 0, 0x50, 0xa5, 0xe6, 0xe9, 0xf4],
+                        GuestAddress(0x1000),
+                    )
+                    .unwrap();
+                for (id, cpu) in cpus.iter_mut().enumerate() {
+                    memory
+                        .memory()
+                        .write_obj(0u8, GuestAddress(0x5000))
+                        .unwrap();
+                    assert!(
+                        matches!(exit(&mut **cpu), VcpuExit::IoOut { port: 0xe9, data } if data == [0x21 + id as u8])
+                    );
+                    assert_eq!(
+                        memory
+                            .memory()
+                            .read_obj::<u8>(GuestAddress(0x5000))
+                            .unwrap(),
+                        0xa5
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[test]
+#[ignore = "requires physical Linux KVM; selected by KVM CI"]
+fn observed_native_completion_clears_provenance_and_the_next_exit_reestablishes_it() {
+    for irqchip in [false, true] {
+        let (vm, memory, mut cpus) = graph(1, irqchip);
+        memory
+            .memory()
+            .write_slice(&[0xec, 0xe6, 0xe9, 0xf4], GuestAddress(0x1000))
+            .unwrap();
+        let CpuState::X86_64(mut state) = cpus[0].get_state().unwrap() else {
+            unreachable!()
+        };
+        state.regs.rdx = 0x1234;
+        cpus[0].set_state(&CpuState::X86_64(state)).unwrap();
+        assert!(matches!(exit(&mut *cpus[0]), VcpuExit::IoIn { .. }));
+        let handles = {
+            let boundary = vm.checkpoint_boundary().unwrap();
+            native(&*vm).checkpoint_cpu_handles(&boundary).unwrap()
+        };
+        assert!(handles[0].lock().unwrap().native_io_unsettled);
+        cpus[0].complete_io_in(&[0x7c]);
+        assert!(handles[0].lock().unwrap().native_io_unsettled);
+        assert_eq!(
+            cpus[0]
+                .settle_checkpoint_io(&mut |_| panic!(
+                    "completed input required another device callback"
+                ))
+                .unwrap(),
+            CheckpointIoState::Complete
+        );
+        assert!(!handles[0].lock().unwrap().native_io_unsettled);
+        assert!(
+            matches!(exit(&mut *cpus[0]), VcpuExit::IoOut { port: 0xe9, data } if data == [0x7c])
+        );
+        assert!(handles[0].lock().unwrap().native_io_unsettled);
+        cpus[0].complete_io_out().unwrap();
+        assert!(handles[0].lock().unwrap().native_io_unsettled);
+        assert_eq!(
+            cpus[0]
+                .settle_checkpoint_io(&mut |_| panic!("acknowledged output replayed its callback"))
+                .unwrap(),
+            CheckpointIoState::Complete
+        );
+        assert!(!handles[0].lock().unwrap().native_io_unsettled);
+    }
+}
diff --git a/src/backend/kvm/checkpoint_io.rs b/src/backend/kvm/checkpoint_io.rs
new file mode 100644
index 0000000000000000000000000000000000000000..eb33d0127928fbf0cd67897eeb0b1bc0306284a5
--- /dev/null
+++ b/src/backend/kvm/checkpoint_io.rs
@@ -0,0 +1,165 @@
+//! Close native I/O through real device service, outside CPU/VM entry locks.
+use super::{KvmVcpu, NativeCore, deadline, run};
+use crate::error::{Error, Result};
+use crate::vm::vcpu::{CheckpointIoReply, CheckpointIoState, VcpuExit};
+use std::panic::{AssertUnwindSafe, catch_unwind, resume_unwind};
+use std::sync::atomic::Ordering;
+
+enum Step {
+    Complete,
+    Deferred,
+    Device(VcpuExit),
+}
+
+struct RestoreImmediate {
+    mapping: *mut kvm_bindings::kvm_run,
+    previous: u8,
+}
+impl Drop for RestoreImmediate {
+    fn drop(&mut self) {
+        // SAFETY: the exclusive core borrow retains the native FD/run mapping
+        // until this guard drops. KVM_RUN has returned before any Rust unwind;
+        // no native slice or header reference escapes run_native. Only this
+        // disjoint u8 entry flag changes, with no concurrent native access.
+        unsafe { (*self.mapping).immediate_exit = self.previous };
+    }
+}
+
+fn fail(core: &mut NativeCore, message: impl std::fmt::Display) -> Error {
+    let failure = format!("KVM checkpoint I/O failed: {message}; guest entry disabled");
+    core.state_failure = Some(failure.clone());
+    Error::Emulator(failure)
+}
+
+impl NativeCore {
+    fn checkpoint_io_step(&mut self) -> Result<Step> {
+        if self.memory_owner.powered_off.load(Ordering::Acquire) {
+            return Ok(Step::Deferred);
+        }
+        self.state_ready()?;
+        if self.servicing_io {
+            return Err(Error::InvalidConfig(
+                "native checkpoint device callback is already in progress".into(),
+            ));
+        }
+        if self.deferred_exit.is_some() {
+            return Ok(Step::Deferred);
+        }
+        if let Some(event) = self.io.event().map_err(Error::Emulator)? {
+            self.servicing_io = true;
+            return Ok(Step::Device(run::public_event(event)));
+        }
+        if !self.io.has_native_completion() {
+            if self.native_io_unsettled {
+                return Err(fail(self, "native completion lost its owned transfer"));
+            }
+            return Ok(Step::Complete);
+        }
+        self.io
+            .ready_for_native_completion()
+            .map_err(Error::Emulator)?;
+        if self
+            .memory_owner
+            .vm_fd
+            .check_extension_raw(kvm_bindings::KVM_CAP_IMMEDIATE_EXIT.into())
+            <= 0
+        {
+            return Err(Error::InvalidConfig(
+                "native checkpoint requires immediate-exit completion".into(),
+            ));
+        }
+        let mapping = self.vcpu_fd.get_kvm_run() as *mut kvm_bindings::kvm_run;
+        // SAFETY: the exclusively borrowed core owns this live initialized
+        // mapping. No native entry or other run-buffer reference exists here.
+        let previous = unsafe { (*mapping).immediate_exit };
+        let restore = RestoreImmediate { mapping, previous };
+        self.vcpu_fd.set_kvm_immediate_exit(1);
+        // Reuse the private worker's blocked userspace signals and entry-only
+        // KVM mask. A caller-thread signal must not interrupt the ioctl before
+        // the kernel has reached its native I/O completion path.
+        let result = deadline::run(self, std::time::Duration::from_millis(10));
+        drop(restore);
+        match result {
+            Ok(None) => {
+                if self.io.has_native_completion() {
+                    return Err(fail(self, "interrupted completion retained native work"));
+                }
+                Ok(Step::Complete)
+            }
+            Err(error) => Err(error),
+            Ok(Some(exit)) if self.io.has_native_completion() => {
+                self.servicing_io = true;
+                Ok(Step::Device(exit))
+            }
+            Ok(Some(exit)) => {
+                // Conservation of a completion-time fault/terminal exit. It
+                // must be returned on resumption and represented by capture;
+                // it is never silently consumed as a successful I/O boundary.
+                self.deferred_exit = Some(exit);
+                Ok(Step::Deferred)
+            }
+        }
+    }
+}
+
+impl KvmVcpu {
+    pub(super) fn settle_native_checkpoint_io(
+        &self,
+        service: &mut dyn FnMut(VcpuExit) -> Result<CheckpointIoReply>,
+    ) -> Result<CheckpointIoState> {
+        loop {
+            let event = match self.with_native(|core| core.checkpoint_io_step())? {
+                Step::Complete => return Ok(CheckpointIoState::Complete),
+                Step::Deferred => return Ok(CheckpointIoState::Deferred),
+                Step::Device(event) => event,
+            };
+            let input = matches!(
+                event,
+                VcpuExit::IoIn { .. } | VcpuExit::IoInString { .. } | VcpuExit::MmioRead { .. }
+            );
+            // Both the CPU guard and VM entry lease have dropped. Device
+            // callbacks may read CPU state or drive backend IRQ lines without
+            // recursively locking this core. Never invent an input value.
+            let reply = match catch_unwind(AssertUnwindSafe(|| service(event))) {
+                Ok(Ok(reply)) => reply,
+                Ok(Err(error)) => {
+                    return self.with_native(|core| {
+                        core.servicing_io = false;
+                        Err(fail(core, error))
+                    });
+                }
+                Err(payload) => {
+                    let _ = self.with_native(|core| {
+                        core.servicing_io = false;
+                        fail(core, "device callback panicked");
+                        Ok(())
+                    });
+                    resume_unwind(payload);
+                }
+            };
+            if matches!(reply, CheckpointIoReply::PowerOff) {
+                // The device effect has already powered off the VM. Publish
+                // before any fallible acknowledgement or another CPU's entry.
+                self.memory_owner.power_off()?;
+            }
+            self.with_native(|core| {
+                core.servicing_io = false;
+                match reply {
+                    CheckpointIoReply::Input(bytes) if input => core.complete_native_input(&bytes),
+                    CheckpointIoReply::Output if !input => core.acknowledge_native_output()?,
+                    CheckpointIoReply::PowerOff if !input => {
+                        core.acknowledge_native_output()?;
+                        core.deferred_exit = Some(VcpuExit::Shutdown);
+                        return Ok(());
+                    }
+                    _ => return Err(fail(core, "device reply kind differs from native request")),
+                }
+                // An output batch can still have unacknowledged elements;
+                // preserve them for the next real service callback. Input
+                // length/protocol failures remain terminal in the owned state.
+                core.io.event().map_err(Error::Emulator)?;
+                Ok(())
+            })?;
+        }
+    }
+}
diff --git a/src/backend/kvm/checkpoint_io_tests.rs b/src/backend/kvm/checkpoint_io_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4697afb3b7385e7ae6089e734d1566db82c7f3e4
--- /dev/null
+++ b/src/backend/kvm/checkpoint_io_tests.rs
@@ -0,0 +1,389 @@
+//! Real native completion frontiers; all replies are actual service results.
+use super::*;
+use crate::devices::bus::{MmioBus, MmioDevice, MmioRange};
+use crate::vm::vcpu::{CheckpointIoReply, CheckpointIoState};
+use std::time::Duration;
+use vm_memory::{Bytes, GuestAddress};
+
+const MMIO: u64 = 0xf000_0000;
+const TAIL: &[u8] = &[0xc6, 0x06, 0x00, 0x20, 0xaa, 0xb0, 0x5a, 0xe6, 0xe9, 0xf4];
+
+fn fixture(program: &[u8], irqchip: bool) -> (Arc<dyn Vm>, GuestMemoryWrapper, Box<dyn VCpu>) {
+    let backend = KvmBackend::new().unwrap();
+    let vm: Arc<dyn Vm> = Arc::from(backend.create_vm().unwrap());
+    vm.configure_cpu_topology(1, 2 * 1024 * 1024).unwrap();
+    let native = vm.as_any().downcast_ref::<KvmVm>().unwrap();
+    if irqchip {
+        native.create_irq_chip().unwrap();
+    }
+    let memory = GuestMemoryWrapper::new(2 * 1024 * 1024).unwrap();
+    native.register_memory(&memory).unwrap();
+    memory
+        .memory()
+        .write_slice(program, GuestAddress(0x1000))
+        .unwrap();
+    let mut cpu = vm
+        .create_vcpu(0, Arc::new(memory.memory().clone()))
+        .unwrap();
+    let CpuState::X86_64(mut state) = cpu.get_state().unwrap() else {
+        unreachable!()
+    };
+    state.regs.rip = 0x1000;
+    state.regs.rflags = 3; // Carry set: INC must preserve it.
+    state.sregs.cs.base = 0;
+    state.sregs.cs.selector = 0;
+    state.sregs.ds.base = 0;
+    state.sregs.ds.selector = 0;
+    state.sregs.ds.limit = u32::MAX;
+    state.sregs.ds.g = true;
+    state.sregs.es.base = 0;
+    state.sregs.es.selector = 0;
+    state.sregs.es.limit = u32::MAX;
+    state.sregs.es.g = true;
+    cpu.set_state(&CpuState::X86_64(state)).unwrap();
+    (vm, memory, cpu)
+}
+
+fn exit(cpu: &mut dyn VCpu) -> VcpuExit {
+    loop {
+        if let Some(exit) = cpu.run_host_slice(Duration::from_millis(100)).unwrap() {
+            return exit;
+        }
+    }
+}
+
+fn unchanged_tail(memory: &GuestMemoryWrapper) {
+    assert_eq!(
+        memory
+            .memory()
+            .read_obj::<u8>(GuestAddress(0x2000))
+            .unwrap(),
+        0
+    );
+}
+
+struct Register {
+    value: u8,
+    calls: Arc<Mutex<Vec<(bool, u8)>>>,
+}
+impl MmioDevice for Register {
+    fn read(&mut self, address: u64, bytes: &mut [u8]) {
+        assert_eq!((address, bytes.len()), (MMIO, 1));
+        bytes[0] = self.value;
+        self.calls.lock().unwrap().push((false, self.value));
+    }
+    fn write(&mut self, address: u64, bytes: &[u8]) {
+        assert_eq!((address, bytes.len()), (MMIO, 1));
+        self.value = bytes[0];
+        self.calls.lock().unwrap().push((true, self.value));
+    }
+}
+
+#[test]
+#[ignore = "requires native Linux KVM; executed by the KVM CI job"]
+fn checkpoint_completion_services_both_mmio_rmw_exits_without_running_the_tail() {
+    for irqchip in [false, true] {
+        // Real-mode INC byte [disp32]; the following store must not execute.
+        let mut program = vec![0x67, 0xfe, 0x05, 0x00, 0x00, 0x00, 0xf0];
+        program.extend_from_slice(TAIL);
+        let (vm, memory, mut cpu) = fixture(&program, irqchip);
+        assert!(matches!(
+            exit(&mut *cpu),
+            VcpuExit::MmioRead {
+                addr: MMIO,
+                size: 1
+            }
+        ));
+        let calls = Arc::new(Mutex::new(Vec::new()));
+        let mut bus = MmioBus::new();
+        bus.register(
+            MmioRange { base: MMIO, len: 1 },
+            Box::new(Register {
+                value: 0x7f,
+                calls: calls.clone(),
+            }),
+        )
+        .unwrap();
+        let state = cpu
+            .settle_checkpoint_io(&mut |event| {
+                // These actual owner operations would deadlock if service retained
+                // either the CPU mutex or a checkpoint writer lease.
+                cpu.get_state()?;
+                if irqchip {
+                    vm.set_irq_line(4, true)?;
+                }
+                match event {
+                    VcpuExit::MmioRead { addr, size: 1 } => {
+                        let mut bytes = [0];
+                        bus.read(addr, &mut bytes)?;
+                        Ok(CheckpointIoReply::Input(bytes.to_vec()))
+                    }
+                    VcpuExit::MmioWrite { addr, data } => {
+                        bus.write(addr, &data)?;
+                        Ok(CheckpointIoReply::Output)
+                    }
+                    event => panic!("unexpected completion event: {event:?}"),
+                }
+            })
+            .unwrap();
+        assert_eq!(state, CheckpointIoState::Complete);
+        assert_eq!(*calls.lock().unwrap(), [(false, 0x7f), (true, 0x80)]);
+        let CpuState::X86_64(state) = cpu.get_state().unwrap() else {
+            unreachable!()
+        };
+        assert_eq!(state.regs.rip, 0x1007);
+        assert_eq!(state.regs.rflags & 0x8d5, 0x891);
+        unchanged_tail(&memory);
+        assert!(matches!(exit(&mut *cpu), VcpuExit::IoOut { port: 0xe9, data } if data == [0x5a]));
+        assert_eq!(
+            memory
+                .memory()
+                .read_obj::<u8>(GuestAddress(0x2000))
+                .unwrap(),
+            0xaa
+        );
+    }
+}
+
+#[test]
+#[ignore = "requires native Linux KVM; executed by the KVM CI job"]
+fn checkpoint_completion_preserves_every_output_batch_element_in_order() {
+    let mut program = vec![0xf3, 0x6e]; // REP OUTSB.
+    program.extend_from_slice(TAIL);
+    let (_vm, memory, mut cpu) = fixture(&program, false);
+    memory
+        .memory()
+        .write_slice(&[0x11, 0x22, 0x33], GuestAddress(0x3000))
+        .unwrap();
+    let CpuState::X86_64(mut state) = cpu.get_state().unwrap() else {
+        unreachable!()
+    };
+    state.regs.rdx = 0x1234;
+    state.regs.rsi = 0x3000;
+    state.regs.rcx = 3;
+    cpu.set_state(&CpuState::X86_64(state)).unwrap();
+    let mut values = Vec::new();
+    for _ in 0..3 {
+        let VcpuExit::IoOut { port, data } = exit(&mut *cpu) else {
+            panic!("REP OUTSB did not retain its next output frontier")
+        };
+        assert_eq!(
+            (port, data.as_slice()),
+            (0x1234, &[[0x11, 0x22, 0x33][values.len()]][..])
+        );
+        let before = values.len();
+        assert_eq!(
+            cpu.settle_checkpoint_io(&mut |event| {
+                let VcpuExit::IoOut { port, data } = event else {
+                    panic!("unexpected event")
+                };
+                assert_eq!(port, 0x1234);
+                values.extend(data);
+                Ok(CheckpointIoReply::Output)
+            })
+            .unwrap(),
+            CheckpointIoState::Complete
+        );
+        assert!(values.len() > before && values.len() <= 3);
+        assert_eq!(values.as_slice(), &[0x11, 0x22, 0x33][..values.len()]);
+        let CpuState::X86_64(state) = cpu.get_state().unwrap() else {
+            unreachable!()
+        };
+        // KVM can expose one OUTS iteration per exit. Once that native I/O
+        // completes, RCX/RSI and a retained REP RIP represent the remaining
+        // guest iterations; settling must not enter them to finish the REP.
+        assert_eq!(state.regs.rsi, 0x3000 + values.len() as u64);
+        assert_eq!(state.regs.rcx, 3 - values.len() as u64);
+        if values.len() == 3 {
+            assert!(matches!(state.regs.rip, 0x1000 | 0x1002));
+        } else {
+            assert_eq!(state.regs.rip, 0x1000);
+        }
+        unchanged_tail(&memory);
+        if values.len() == 3 {
+            break;
+        }
+    }
+    assert_eq!(values, [0x11, 0x22, 0x33]);
+    // A zero-count REP frontier must resume directly into the following code,
+    // without another device output from the completed string instruction.
+    assert!(matches!(exit(&mut *cpu), VcpuExit::IoOut { port: 0xe9, data } if data == [0x5a]));
+}
+
+#[test]
+#[ignore = "requires native Linux KVM; executed by the KVM CI job"]
+fn checkpoint_completion_installs_the_actual_batched_input_once() {
+    let mut program = vec![0xf3, 0x6c]; // REP INSB.
+    program.extend_from_slice(TAIL);
+    let (_vm, memory, mut cpu) = fixture(&program, false);
+    memory
+        .memory()
+        .write_slice(&[0xee; 3], GuestAddress(0x3000))
+        .unwrap();
+    let CpuState::X86_64(mut state) = cpu.get_state().unwrap() else {
+        unreachable!()
+    };
+    state.regs.rdx = 0x1234;
+    state.regs.rdi = 0x3000;
+    state.regs.rcx = 3;
+    cpu.set_state(&CpuState::X86_64(state)).unwrap();
+    assert!(matches!(
+        exit(&mut *cpu),
+        VcpuExit::IoInString {
+            port: 0x1234,
+            size: 1,
+            count: 3
+        }
+    ));
+    let mut calls = 0;
+    assert_eq!(
+        cpu.settle_checkpoint_io(&mut |event| {
+            assert!(matches!(
+                event,
+                VcpuExit::IoInString {
+                    port: 0x1234,
+                    size: 1,
+                    count: 3
+                }
+            ));
+            calls += 1;
+            Ok(CheckpointIoReply::Input(vec![0x31, 0x42, 0x53]))
+        })
+        .unwrap(),
+        CheckpointIoState::Complete
+    );
+    assert_eq!(calls, 1);
+    let mut bytes = [0; 3];
+    memory
+        .memory()
+        .read_slice(&mut bytes, GuestAddress(0x3000))
+        .unwrap();
+    assert_eq!(bytes, [0x31, 0x42, 0x53]);
+    unchanged_tail(&memory);
+}
+
+#[test]
+#[ignore = "requires native Linux KVM; executed by the KVM CI job"]
+fn powered_off_output_retains_the_unapplied_tail_and_forbids_native_entry() {
+    let mut program = vec![0xf3, 0x6f]; // REP OUTSW.
+    program.extend_from_slice(TAIL);
+    let (_vm, memory, mut cpu) = fixture(&program, false);
+    memory
+        .memory()
+        .write_slice(&[0, 0x20, 0x11, 0x11, 0x22, 0x22], GuestAddress(0x3000))
+        .unwrap();
+    let CpuState::X86_64(mut state) = cpu.get_state().unwrap() else {
+        unreachable!()
+    };
+    state.regs.rdx = 0x604;
+    state.regs.rsi = 0x3000;
+    state.regs.rcx = 3;
+    cpu.set_state(&CpuState::X86_64(state)).unwrap();
+    assert!(matches!(exit(&mut *cpu), VcpuExit::IoOut { port: 0x604, data } if data == [0, 0x20]));
+    let mut calls = 0;
+    assert_eq!(
+        cpu.settle_checkpoint_io(&mut |event| {
+            assert!(matches!(event, VcpuExit::IoOut { port: 0x604, data } if data == [0, 0x20]));
+            calls += 1;
+            Ok(CheckpointIoReply::PowerOff)
+        })
+        .unwrap(),
+        CheckpointIoState::Deferred
+    );
+    assert_eq!(calls, 1);
+    assert!(matches!(cpu.run().unwrap(), VcpuExit::Shutdown));
+    assert!(matches!(cpu.run().unwrap(), VcpuExit::Shutdown));
+    unchanged_tail(&memory);
+}
+
+#[test]
+#[ignore = "requires native Linux KVM; executed by the KVM CI job"]
+fn failed_input_service_never_supplies_a_replacement_value_or_enters_the_guest() {
+    let mut program = vec![0xe4, 0x80]; // IN AL,0x80.
+    program.extend_from_slice(TAIL);
+    let (_vm, memory, mut cpu) = fixture(&program, false);
+    assert!(matches!(
+        exit(&mut *cpu),
+        VcpuExit::IoIn {
+            port: 0x80,
+            size: 1
+        }
+    ));
+    assert!(
+        cpu.settle_checkpoint_io(&mut |_| Err(Error::Emulator("actual service failure".into())))
+            .is_err()
+    );
+    assert!(cpu.run().is_err());
+    unchanged_tail(&memory);
+}
+
+#[test]
+#[ignore = "requires native Linux KVM; executed by the KVM CI job"]
+fn short_input_reply_retains_destination_bytes_and_disables_further_entry() {
+    let mut program = vec![0xf3, 0x6c];
+    program.extend_from_slice(TAIL);
+    let (_vm, memory, mut cpu) = fixture(&program, false);
+    memory
+        .memory()
+        .write_slice(&[0xee; 3], GuestAddress(0x3000))
+        .unwrap();
+    let CpuState::X86_64(mut state) = cpu.get_state().unwrap() else {
+        unreachable!()
+    };
+    state.regs.rdx = 0x1234;
+    state.regs.rdi = 0x3000;
+    state.regs.rcx = 3;
+    cpu.set_state(&CpuState::X86_64(state)).unwrap();
+    assert!(matches!(
+        exit(&mut *cpu),
+        VcpuExit::IoInString {
+            port: 0x1234,
+            size: 1,
+            count: 3
+        }
+    ));
+    assert!(
+        cpu.settle_checkpoint_io(&mut |_| Ok(CheckpointIoReply::Input(vec![0x31, 0x42])))
+            .is_err()
+    );
+    assert!(cpu.run().is_err());
+    let mut bytes = [0; 3];
+    memory
+        .memory()
+        .read_slice(&mut bytes, GuestAddress(0x3000))
+        .unwrap();
+    assert_eq!(bytes, [0xee; 3]);
+    unchanged_tail(&memory);
+}
+
+#[test]
+#[ignore = "requires native Linux KVM; executed by the KVM CI job"]
+fn reentrant_checkpoint_service_rejects_before_redispatching_the_device() {
+    let mut program = vec![0xe6, 0x80];
+    program.extend_from_slice(TAIL);
+    let (_vm, memory, mut cpu) = fixture(&program, false);
+    assert!(matches!(
+        exit(&mut *cpu),
+        VcpuExit::IoOut { port: 0x80, .. }
+    ));
+    let mut outer_calls = 0;
+    let mut nested_calls = 0;
+    assert_eq!(
+        cpu.settle_checkpoint_io(&mut |_| {
+            outer_calls += 1;
+            let nested = cpu.settle_checkpoint_io(&mut |_| {
+                nested_calls += 1;
+                Ok(CheckpointIoReply::Output)
+            });
+            assert!(
+                nested.is_err(),
+                "reentrant checkpoint redispatched the device"
+            );
+            Ok(CheckpointIoReply::Output)
+        })
+        .unwrap(),
+        CheckpointIoState::Complete
+    );
+    assert_eq!((outer_calls, nested_calls), (1, 0));
+    unchanged_tail(&memory);
+}
diff --git a/src/backend/kvm/clock_gate.rs b/src/backend/kvm/clock_gate.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2e52c6361c22050b8f90d732ae5b34372429fafb
--- /dev/null
+++ b/src/backend/kvm/clock_gate.rs
@@ -0,0 +1,189 @@
+//! A restored common clock starts at managed entry, after stopped publication.
+use super::{KvmVcpu, MemoryOwner, NativeCore, deadline};
+use crate::error::{Error, Result};
+use crate::vm::timing::TimingContext;
+use crate::vm::vcpu::VcpuExit;
+use std::sync::atomic::Ordering;
+use std::sync::{Arc, MutexGuard};
+use std::time::Duration;
+
+pub(super) struct PendingClock {
+    pub(super) native: super::checkpoint::ClockImage,
+    pub(super) devices: Option<(Arc<TimingContext>, u64)>,
+}
+
+impl PendingClock {
+    pub(super) fn validate_device_phase(&self) -> Result<()> {
+        if let Some((devices, nanos)) = &self.devices
+            && !devices.is_stopped_at(*nanos)
+        {
+            return Err(invalid("staged device clock phase changed before entry"));
+        }
+        Ok(())
+    }
+
+    /// A new restoration may replace the saved phase, but cannot detach the
+    /// still-stopped software clock or transfer it to an unrelated VM owner.
+    pub(super) fn validate_device_owner(&self, next: Option<&Arc<TimingContext>>) -> Result<()> {
+        if let Some((owner, _)) = &self.devices
+            && !next.is_some_and(|next| Arc::ptr_eq(owner, next))
+        {
+            return Err(invalid("staged device clock owner cannot be replaced"));
+        }
+        Ok(())
+    }
+}
+
+fn invalid(message: impl std::fmt::Display) -> Error {
+    Error::Emulator(format!("native KVM first entry: {message}"))
+}
+
+impl MemoryOwner {
+    pub(super) fn resume_clock_pending(&self) -> Result<bool> {
+        self.resume_clock
+            .lock()
+            .map(|clock| clock.is_some())
+            .map_err(|_| {
+                self.poisoned.store(true, Ordering::Release);
+                invalid("resume clock lock poisoned; guest entry disabled")
+            })
+    }
+}
+
+impl KvmVcpu {
+    fn run_core(&self) -> Result<MutexGuard<'_, NativeCore>> {
+        self.core.lock().map_err(|_| {
+            self.memory_owner.poisoned.store(true, Ordering::Release);
+            Error::Emulator("native KVM CPU owner lock poisoned; guest entry disabled".into())
+        })
+    }
+
+    pub(super) fn run_native_host_slice(&self, limit: Duration) -> Result<Option<VcpuExit>> {
+        let entry = self.memory_owner.entry()?;
+        let mut core = self.run_core()?;
+        if !self.memory_owner.resume_clock_pending()? || !core.will_enter_native()? {
+            return core.run_host_slice(limit);
+        }
+        // Never upgrade a read lock while retaining it or a CPU guard.
+        drop(core);
+        drop(entry);
+        let _exclusive = self.memory_owner.exclusive_entry()?;
+        let mut core = self.run_core()?;
+        // A competing entry may already have consumed the epoch, or a stopped
+        // writer may have changed this CPU into a non-entry state.
+        if self.memory_owner.resume_clock_pending()? && core.will_enter_native()? {
+            deadline::run_at_resume(&mut core, limit)
+        } else {
+            core.run_host_slice(limit)
+        }
+    }
+}
+
+impl NativeCore {
+    fn will_enter_native(&self) -> Result<bool> {
+        if self.memory_owner.powered_off.load(Ordering::Acquire)
+            || self.userspace_halted
+            || self.deferred_exit.is_some()
+        {
+            return Ok(false);
+        }
+        self.state_ready()?;
+        // Returning an owned request does not enter KVM. Missing input replies
+        // still fail in the ordinary entry validator without consuming phase.
+        Ok(self.io.event().map_err(Error::Emulator)?.is_none())
+    }
+
+    /// Only the private deadline worker calls this, while its parent retains
+    /// VM write exclusion and this CPU's guard. All other managed CPU guards
+    /// are therefore free: ordinary SDK borrows and state operations retain a
+    /// VM read lease before taking a CPU guard. This exceptional all-CPU path
+    /// may lock the selected CPU first without a competing lock-order cycle.
+    pub(super) fn activate_resume_clock(&mut self) -> Result<()> {
+        let owner = self.memory_owner.clone();
+        let result = (|| {
+            owner.ready()?;
+            if owner.sdk_cpus.load(Ordering::Acquire) != 0
+                || owner.external_vm_access.load(Ordering::Acquire)
+            {
+                return Err(invalid("unmanaged descriptors changed the resume owner"));
+            }
+            let mut pending = owner
+                .resume_clock
+                .lock()
+                .map_err(|_| invalid("resume clock lock poisoned"))?;
+            let Some(clock) = pending.as_ref() else {
+                return Ok(());
+            };
+            clock.validate_device_phase()?;
+            let handles = owner
+                .managed_cpus
+                .lock()
+                .map_err(|_| invalid("CPU membership lock poisoned"))?
+                .iter()
+                .map(|(&id, handle)| {
+                    handle
+                        .upgrade()
+                        .map(|handle| (id, handle))
+                        .ok_or_else(|| invalid("a managed CPU was destroyed before first entry"))
+                })
+                .collect::<Result<Vec<_>>>()?;
+            if !handles.iter().any(|(id, _)| *id == self.id) {
+                return Err(invalid("entering CPU is absent from the managed graph"));
+            }
+            let mut peers = Vec::with_capacity(handles.len().saturating_sub(1));
+            for (id, handle) in &handles {
+                if *id != self.id {
+                    let peer = handle
+                        .lock()
+                        .map_err(|_| invalid("peer CPU owner poisoned"))?;
+                    if peer.id != *id {
+                        return Err(invalid("peer identity differs from its registry key"));
+                    }
+                    peers.push(peer);
+                }
+            }
+            let khz = self
+                .native_tsc_khz
+                .filter(|khz| *khz != 0)
+                .ok_or_else(|| invalid("native TSC rate was unavailable at CPU creation"))?;
+            for core in std::iter::once(&*self).chain(peers.iter().map(|core| &**core)) {
+                core.state_ready()?;
+                if core.native_tsc_khz != Some(khz)
+                    || core.servicing_io
+                    || core.native_io_unsettled
+                    || core.io.has_native_completion()
+                {
+                    return Err(invalid(
+                        "CPU rate or in-flight ownership changed before resume",
+                    ));
+                }
+                // A peer's owned direct result awaits userspace delivery; it
+                // neither enters KVM nor holds a native completion buffer.
+                super::checkpoint::DeferredImage::capture(core.deferred_exit.as_ref())?;
+            }
+            let mut descriptors = Vec::with_capacity(handles.len());
+            descriptors.push((self.id, &self.vcpu_fd));
+            descriptors.extend(peers.iter().map(|core| (core.id, &core.vcpu_fd)));
+            descriptors.sort_unstable_by_key(|(id, _)| *id);
+            let applied = clock
+                .native
+                .restore_at_resume(&owner.vm_fd, &descriptors, khz)
+                .map_err(invalid)?;
+            if let Some((devices, _)) = &clock.devices
+                && !devices.resume_wall_at(applied.resume_instant)
+            {
+                return Err(invalid("staged device clock was resumed independently"));
+            }
+            // Keep the canonical record on every failure, and remove it only
+            // after all offsets and the common VM clock have been published.
+            *pending = None;
+            Ok(())
+        })();
+        if result.is_err() {
+            // Native setters can have changed a prefix. No other CPU may
+            // enter after an incomplete common-epoch activation.
+            owner.poisoned.store(true, Ordering::Release);
+        }
+        result
+    }
+}
