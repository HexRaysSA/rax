+            );
+            assert!(matches!(
+                fixture.vm.vcpus[id].run().unwrap(),
+                VcpuExit::Shutdown
+            ));
+            assert_eq!(fixture.settle(id), CheckpointIoState::Deferred);
+        }
+        fixture.tail_is_stopped();
+        assert!(calls.lock().unwrap().is_empty());
+        assert!(fixture.vm.serial.lock().unwrap().has_input());
+    }
+}
