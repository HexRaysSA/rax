diff --git a/src/backend/kvm/checkpoint/msrs.rs b/src/backend/kvm/checkpoint/msrs.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e0d83fc556d7edd820bad50762264f64771193ec
--- /dev/null
+++ b/src/backend/kvm/checkpoint/msrs.rs
@@ -0,0 +1,231 @@
+//! Profile-admitted migration MSRs; advancing clocks have their own producer.
+use crate::error::{Error, Result};
+use kvm_bindings::{CpuId, Msrs, kvm_msr_entry};
+use kvm_ioctls::{Kvm, VcpuFd};
+use serde::{Deserialize, Deserializer, Serialize};
+use std::collections::HashSet;
+
+const TSC: u32 = 0x10;
+const HYPERV_REFERENCE_TIME: u32 = 0x4000_0020;
+const HYPERV_VP_RUNTIME: u32 = 0x4000_0010;
+const ASYNC_PF_INTERRUPT: u32 = 0x4b56_4d06;
+const ASYNC_PF_INTERRUPT_FEATURE: u32 = 1 << 14;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(in crate::backend::kvm) struct Plan {
+    indices: Vec<u32>,
+    counter_indices: Vec<u32>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub(in crate::backend::kvm) struct Register {
+    pub(in crate::backend::kvm) index: u32,
+    pub(in crate::backend::kvm) value: u64,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub(in crate::backend::kvm) struct Image {
+    #[serde(deserialize_with = "registers")]
+    registers: Vec<Register>,
+    #[serde(deserialize_with = "registers")]
+    counters: Vec<Register>,
+}
+
+fn registers<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> std::result::Result<Vec<Register>, D::Error> {
+    // Match the retained SDK's FAM allocation bound. The exact ordered
+    // membership is checked against the current host plan after decoding.
+    super::bounded::sequence::<_, _, { kvm_bindings::KVM_MAX_MSR_ENTRIES }>(deserializer)
+}
+
+fn invalid(message: impl std::fmt::Display) -> Error {
+    Error::InvalidConfig(format!("native KVM migration MSR bank: {message}"))
+}
+
+fn table(entries: &[kvm_msr_entry]) -> Result<Msrs> {
+    Msrs::from_entries(entries).map_err(invalid)
+}
+
+impl Plan {
+    /// Preserve the kernel's migration order in each bank. Three advancing
+    /// counters require coordinated clock restoration. ASYNC_PF_INT needs the KVM
+    /// guest feature and kernel LAPIC; GET support alone does not imply SET.
+    pub(in crate::backend::kvm) fn capture(
+        kvm: &Kvm,
+        guest: &CpuId,
+        irqchip: bool,
+    ) -> Result<Self> {
+        let features = if super::super::cpuid::has_kvm_signature(guest.as_slice()) {
+            guest
+                .as_slice()
+                .iter()
+                .find(|entry| entry.function == 0x4000_0001 && entry.index == 0)
+                .map_or(0, |entry| entry.eax)
+        } else {
+            0
+        };
+        let indices = kvm.get_msr_index_list()?;
+        let mut seen = HashSet::new();
+        let mut admitted = Vec::new();
+        let mut counters = Vec::new();
+        for &index in indices.as_slice() {
+            if !seen.insert(index) {
+                return Err(invalid("duplicate kernel migration index"));
+            }
+            let feature = match index {
+                0x11 | 0x12 => Some(1 << 0),
+                0x4b56_4d00 | 0x4b56_4d01 => Some(1 << 3),
+                0x4b56_4d02 => Some(1 << 4),
+                0x4b56_4d03 => Some(1 << 5),
+                0x4b56_4d04 => Some(1 << 6),
+                0x4b56_4d05 => Some(1 << 12),
+                0x4b56_4d06 | 0x4b56_4d07 => Some(ASYNC_PF_INTERRUPT_FEATURE),
+                _ => None,
+            };
+            if feature.is_some_and(|feature| features & feature == 0)
+                || (index == ASYNC_PF_INTERRUPT && !irqchip)
+            {
+                continue;
+            }
+            if matches!(index, TSC | HYPERV_REFERENCE_TIME | HYPERV_VP_RUNTIME) {
+                counters.push(index);
+            } else {
+                admitted.push(index);
+            }
+        }
+        Ok(Self {
+            indices: admitted,
+            counter_indices: counters,
+        })
+    }
+
+    pub(in crate::backend::kvm) fn indices(&self) -> &[u32] {
+        &self.indices
+    }
+}
+
+impl Image {
+    pub(in crate::backend::kvm) fn capture(cpu: &VcpuFd, plan: &Plan) -> Result<Self> {
+        let entries: Vec<_> = plan
+            .indices
+            .iter()
+            .chain(&plan.counter_indices)
+            .map(|&index| kvm_msr_entry {
+                index,
+                ..Default::default()
+            })
+            .collect();
+        let mut native = table(&entries)?;
+        let count = cpu.get_msrs(&mut native)?;
+        if count != entries.len() {
+            return Err(invalid(format_args!(
+                "read completed {count} of {} entries",
+                entries.len()
+            )));
+        }
+        Ok(Self {
+            registers: native.as_slice()[..plan.indices.len()]
+                .iter()
+                .map(|entry| Register {
+                    index: entry.index,
+                    value: entry.data,
+                })
+                .collect(),
+            counters: native.as_slice()[plan.indices.len()..]
+                .iter()
+                .map(|entry| Register {
+                    index: entry.index,
+                    value: entry.data,
+                })
+                .collect(),
+        })
+    }
+
+    pub(in crate::backend::kvm) fn registers(&self) -> &[Register] {
+        &self.registers
+    }
+
+    pub(in crate::backend::kvm) fn counters(&self) -> &[Register] {
+        &self.counters
+    }
+
+    pub(in crate::backend::kvm) fn from_parts(
+        registers: Vec<Register>,
+        counters: Vec<Register>,
+        plan: &Plan,
+    ) -> Result<Self> {
+        let image = Self {
+            registers,
+            counters,
+        };
+        image.validate(plan)?;
+        Ok(image)
+    }
+
+    pub(in crate::backend::kvm) fn validate(&self, plan: &Plan) -> Result<()> {
+        if self.counters.len() != plan.counter_indices.len()
+            || self
+                .counters
+                .iter()
+                .map(|entry| entry.index)
+                .ne(plan.counter_indices.iter().copied())
+            || self.registers.len() != plan.indices.len()
+            || self
+                .registers
+                .iter()
+                .map(|entry| entry.index)
+                .ne(plan.indices.iter().copied())
+        {
+            return Err(invalid(
+                "record order or membership differs from the selected profile",
+            ));
+        }
+        Ok(())
+    }
+
+    /// Apply only to an exclusively stopped disposable destination or under a
+    /// complete native rollback transaction. SET_MSRS may mutate a prefix on
+    /// failure; this helper does not make the kernel batch transactional.
+    /// Counter values are retained in the image for the coordinated clock
+    /// producer. This method restores only the stored-register bank.
+    pub(in crate::backend::kvm) fn restore_stored_registers(
+        &self,
+        cpu: &VcpuFd,
+        plan: &Plan,
+    ) -> Result<()> {
+        self.validate(plan)?;
+        let entries: Vec<_> = self
+            .registers
+            .iter()
+            .map(|entry| kvm_msr_entry {
+                index: entry.index,
+                data: entry.value,
+                ..Default::default()
+            })
+            .collect();
+        let count = cpu.set_msrs(&table(&entries)?)?;
+        if count != entries.len() {
+            return Err(invalid(format_args!(
+                "write completed {count} of {} entries; destination may be partially changed",
+                entries.len()
+            )));
+        }
+        // The kernel can accept host writes to read-only migration fields
+        // while ignoring their supplied values. Count success alone does not
+        // prove that the requested stored image was installed.
+        let readback = Self::capture(cpu, plan)?;
+        if let Some((expected, actual)) = self
+            .registers
+            .iter()
+            .zip(&readback.registers)
+            .find(|(expected, actual)| expected != actual)
+        {
+            return Err(invalid(format_args!(
+                "stored-bank readback at {:#x} differs: expected {:#x}, observed {:#x}; destination may be partially changed",
+                expected.index, expected.value, actual.value,
+            )));
+        }
+        Ok(())
+    }
+}
diff --git a/src/backend/kvm/checkpoint/nested.rs b/src/backend/kvm/checkpoint/nested.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4e205108a111577f21f59fc52eb96591df1df44d
--- /dev/null
+++ b/src/backend/kvm/checkpoint/nested.rs
@@ -0,0 +1,113 @@
+//! Exact native nested-state envelope, including live header-only VMXON state.
+use crate::error::{Error, Result};
+use kvm_ioctls::{KvmNestedStateBuffer, VcpuFd};
+use serde::{Deserialize, Deserializer, Serialize};
+
+const HEADER_BYTES: usize = 128;
+const BUFFER_BYTES: usize = std::mem::size_of::<KvmNestedStateBuffer>();
+const _: () = {
+    assert!(std::mem::size_of::<kvm_bindings::kvm_nested_state>() == HEADER_BYTES);
+    assert!(std::mem::offset_of!(KvmNestedStateBuffer, hdr) == 8);
+    assert!(std::mem::offset_of!(KvmNestedStateBuffer, data) == HEADER_BYTES);
+    assert!(BUFFER_BYTES == 8320);
+};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub(in crate::backend::kvm) struct Image {
+    #[serde(deserialize_with = "bytes")]
+    bytes: Vec<u8>,
+}
+
+fn bytes<'de, D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Vec<u8>, D::Error> {
+    super::bounded::sequence::<_, _, BUFFER_BYTES>(deserializer)
+}
+
+fn invalid(message: &str) -> Error {
+    Error::InvalidConfig(format!("native KVM nested-state envelope: {message}"))
+}
+
+impl Image {
+    /// Capture actual returned bytes even when the SDK returns None. That
+    /// return value only distinguishes a data tail; a 128-byte header can
+    /// retain VMXON state needed for source-free VMXOFF continuation.
+    pub(in crate::backend::kvm) fn capture(cpu: &VcpuFd, capacity: usize) -> Result<Option<Self>> {
+        if capacity == 0 {
+            return Ok(None);
+        }
+        if !(HEADER_BYTES..=BUFFER_BYTES).contains(&capacity) {
+            return Err(invalid("kernel capacity exceeds the admitted SDK buffer"));
+        }
+        let mut buffer = KvmNestedStateBuffer::empty();
+        let _tail_length = cpu.nested_state(&mut buffer)?;
+        let length = buffer.size as usize;
+        if !(HEADER_BYTES..=capacity).contains(&length) {
+            return Err(invalid("kernel returned an out-of-bounds state length"));
+        }
+        // SAFETY: empty() initializes the full fixed-size integer/byte/union
+        // buffer before the synchronous GET. The layout assertions establish
+        // contiguous 8-byte metadata, 120-byte header and 8192-byte data, with
+        // no uncovered struct padding. Every union byte is represented by
+        // byte arrays; no pointer, reference or invalid scalar representation
+        // is present. The checked actual length fits the live local buffer.
+        // No native entry or mutation occurs while these bytes are copied;
+        // u8 needs no additional alignment and the copied Vec owns its data.
+        let bytes = unsafe {
+            std::slice::from_raw_parts(
+                (&buffer as *const KvmNestedStateBuffer).cast::<u8>(),
+                length,
+            )
+        }
+        .to_vec();
+        Ok(Some(Self::from_bytes(bytes, capacity)?))
+    }
+
+    /// Envelope admission only. The complete producer must separately admit
+    /// CPUID/vendor/profile compatibility, nested control fields, VMCS contents
+    /// and restore order before coordinated publication and rollback.
+    pub(in crate::backend::kvm) fn from_bytes(bytes: Vec<u8>, capacity: usize) -> Result<Self> {
+        let image = Self { bytes };
+        image.validate_envelope(capacity)?;
+        Ok(image)
+    }
+
+    pub(in crate::backend::kvm) fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+
+    pub(in crate::backend::kvm) fn validate_envelope(&self, capacity: usize) -> Result<()> {
+        if !(HEADER_BYTES..=BUFFER_BYTES).contains(&capacity)
+            || !(HEADER_BYTES..=capacity).contains(&self.bytes.len())
+        {
+            return Err(invalid("record length does not fit the target capacity"));
+        }
+        let format = u16::from_le_bytes(self.bytes[2..4].try_into().unwrap());
+        if !matches!(format, 0 | 1) {
+            return Err(invalid("unknown nested-state vendor format"));
+        }
+        let declared = u32::from_le_bytes(self.bytes[4..8].try_into().unwrap()) as usize;
+        if declared != self.bytes.len() {
+            return Err(invalid("declared length differs from the owned record"));
+        }
+        Ok(())
+    }
+
+    pub(in crate::backend::kvm) fn restore(&self, cpu: &VcpuFd, capacity: usize) -> Result<()> {
+        self.validate_envelope(capacity)?;
+        let mut buffer = KvmNestedStateBuffer::empty();
+        // SAFETY: the envelope has an exact validated length within the
+        // initialized, statically checked fixed SDK layout. Source and target
+        // are disjoint owned allocations, valid for the entire byte count;
+        // u8 requires no alignment. All destination fields are integer/byte
+        // representations. The local mutable buffer has no aliases and is
+        // borrowed immutably by the subsequent synchronous native setter.
+        unsafe {
+            std::ptr::copy_nonoverlapping(
+                self.bytes.as_ptr(),
+                (&mut buffer as *mut KvmNestedStateBuffer).cast::<u8>(),
+                self.bytes.len(),
+            );
+        }
+        cpu.set_nested_state(&buffer)?;
+        Ok(())
+    }
+}
diff --git a/src/backend/kvm/checkpoint/owner.rs b/src/backend/kvm/checkpoint/owner.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7b23d71cba9ee6e3ac7a3661b16102459635c4f3
--- /dev/null
+++ b/src/backend/kvm/checkpoint/owner.rs
@@ -0,0 +1,417 @@
+//! Actual managed-owner admission for the native CPU and common clock banks.
+//!
+//! This is an internal composition layer. PIT/timer state, terminal I/O,
+//! physical RAM publication, rollback and first-entry
+//! activation belong to the complete producer; public snapshot hooks remain
+//! inactive until those components are composed.
+use super::{bounded, clock, cpu, deferred, shared};
+use crate::backend::CheckpointBoundary;
+use crate::backend::kvm::{KvmVm, NativeCore};
+use crate::error::{Error, Result};
+use serde::{Deserialize, Deserializer, Serialize};
+use std::sync::atomic::Ordering;
+use std::sync::{Arc, Mutex, MutexGuard};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(in crate::backend::kvm) struct Image {
+    version: u16,
+    #[serde(deserialize_with = "cpu_images")]
+    cpus: Vec<cpu::Image>,
+    #[serde(deserialize_with = "deferred_images")]
+    deferred: Vec<Option<deferred::Image>>,
+    powered_off: bool,
+    #[serde(deserialize_with = "terminal_images")]
+    terminal: Vec<Option<super::super::io::TerminalImage>>,
+    clock: clock::Image,
+    shared: Option<shared::Image>,
+}
+
+fn cpu_images<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> std::result::Result<Vec<cpu::Image>, D::Error> {
+    bounded::sequence::<_, _, { u8::MAX as usize }>(deserializer)
+}
+
+fn deferred_images<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> std::result::Result<Vec<Option<deferred::Image>>, D::Error> {
+    bounded::sequence::<_, _, { u8::MAX as usize }>(deserializer)
+}
+
+fn terminal_images<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> std::result::Result<Vec<Option<super::super::io::TerminalImage>>, D::Error> {
+    bounded::sequence::<_, _, { u8::MAX as usize }>(deserializer)
+}
+
+fn invalid(message: impl std::fmt::Display) -> Error {
+    Error::InvalidConfig(format!("managed native checkpoint banks: {message}"))
+}
+
+fn ready(core: &NativeCore) -> Result<()> {
+    core.state_ready()?;
+    if core.servicing_io {
+        return Err(invalid("device callback is still active"));
+    }
+    if (core.native_io_unsettled || core.io.has_native_completion())
+        && !core.memory_owner.powered_off.load(Ordering::Acquire)
+    {
+        return Err(invalid("pending native I/O needs its complete producer"));
+    }
+    core.io.capture_terminal().map_err(invalid)?;
+    deferred::Image::capture(core.deferred_exit.as_ref())?;
+    Ok(())
+}
+
+fn native_rate(cpus: &[MutexGuard<'_, NativeCore>]) -> Result<u32> {
+    let first = cpus
+        .first()
+        .and_then(|cpu| cpu.native_tsc_khz)
+        .filter(|khz| *khz != 0)
+        .ok_or_else(|| invalid("native TSC rate was unavailable at CPU creation"))?;
+    if cpus.iter().any(|cpu| cpu.native_tsc_khz != Some(first)) {
+        return Err(invalid("managed CPUs have different native TSC rates"));
+    }
+    Ok(first)
+}
+
+fn lock_cpus<'a>(
+    vm: &KvmVm,
+    handles: &'a [Arc<Mutex<NativeCore>>],
+) -> Result<Vec<MutexGuard<'a, NativeCore>>> {
+    let mut cpus = Vec::with_capacity(handles.len());
+    for handle in handles {
+        cpus.push(handle.lock().map_err(|_| {
+            vm.memory.poisoned.store(true, Ordering::Release);
+            Error::Emulator("native CPU owner poisoned during checkpoint bank capture".into())
+        })?);
+    }
+    Ok(cpus)
+}
+
+impl KvmVm {
+    fn checkpoint_cpu_handles(
+        &self,
+        boundary: &CheckpointBoundary<'_>,
+    ) -> Result<Vec<Arc<Mutex<NativeCore>>>> {
+        boundary.require_owner(self.memory.identity())?;
+        self.memory.ready()?;
+        let count = self
+            .profile
+            .lock()
+            .map_err(|_| invalid("CPU profile lock poisoned"))?
+            .count
+            .ok_or_else(|| invalid("CPU topology is not configured"))?;
+        let registry = self
+            .memory
+            .managed_cpus
+            .lock()
+            .map_err(|_| invalid("CPU membership lock poisoned"))?;
+        if registry.len() != usize::from(count)
+            || registry.keys().copied().ne(0..u32::from(count))
+            || self.memory.sdk_cpus.load(Ordering::Acquire) != 0
+            || self.memory.external_vm_access.load(Ordering::Acquire)
+        {
+            return Err(invalid("CPU membership differs from the managed topology"));
+        }
+        registry
+            .values()
+            .map(|cpu| {
+                cpu.upgrade()
+                    .ok_or_else(|| invalid("managed CPU owner was destroyed"))
+            })
+            .collect()
+    }
+
+    /// Derive all CPU images and the common clock from the actual stopped
+    /// owner set. The caller cannot substitute descriptors, IDs or profiles.
+    pub(in crate::backend::kvm) fn capture_native_banks(
+        &self,
+        boundary: &CheckpointBoundary<'_>,
+    ) -> Result<Image> {
+        let handles = self.checkpoint_cpu_handles(boundary)?;
+        let cores = lock_cpus(self, &handles)?;
+        let irqchip = self.memory.irqchip_created.load(Ordering::Acquire);
+        let native_khz = native_rate(&cores)?;
+        // GET_MP_STATE can accept INIT/SIPI. Admit every CPU's existing
+        // native I/O/deferred phase before the first such observation.
+        for core in &cores {
+            ready(core)?;
+        }
+        // Admit a stopped software phase before native CPU getters, including
+        // GET_MP_STATE, can accept pending events. A second capture cannot pair
+        // the saved native epoch with an independently changed device clock.
+        let pending = self
+            .memory
+            .resume_clock
+            .lock()
+            .map_err(|_| invalid("native resume clock lock poisoned"))?;
+        if let Some(pending) = &*pending {
+            pending.validate_device_phase()?;
+        }
+        let pending_clock = pending.as_ref().map(|clock| clock.native.clone());
+        drop(pending);
+        let mut cpus = Vec::with_capacity(cores.len());
+        for core in &cores {
+            cpus.push(cpu::Image::capture(
+                &self.memory.checkpoint_kvm,
+                &self.memory.vm_fd,
+                &core.vcpu_fd,
+                core.id,
+                &core.configured_cpuid,
+                irqchip,
+                core.userspace_halted,
+            )?);
+        }
+        let descriptors: Vec<_> = cores.iter().map(|cpu| (cpu.id, &cpu.vcpu_fd)).collect();
+        // A second stopped capture before entry must retain the saved phase,
+        // rather than count the destination's RAM/device-publication delay.
+        let clock = match pending_clock {
+            Some(clock) => clock,
+            None => clock::Image::capture(&self.memory.vm_fd, &descriptors, native_khz)
+                .map_err(invalid)?,
+        };
+        let shared = irqchip
+            .then(|| {
+                let lines = self
+                    .memory
+                    .irq_lines
+                    .lock()
+                    .map_err(|_| invalid("IRQ line ownership lock poisoned"))?;
+                shared::Image::capture(&self.memory.vm_fd, &lines)
+            })
+            .transpose()?;
+        let image = Image {
+            version: 4,
+            cpus,
+            deferred: cores
+                .iter()
+                .map(|core| deferred::Image::capture(core.deferred_exit.as_ref()))
+                .collect::<Result<_>>()?,
+            powered_off: self.memory.powered_off.load(Ordering::Acquire),
+            terminal: cores
+                .iter()
+                .map(|core| core.io.capture_terminal().map_err(invalid))
+                .collect::<Result<_>>()?,
+            clock,
+            shared,
+        };
+        image.validate_locked(self, &cores)?;
+        Ok(image)
+    }
+}
+
+impl Image {
+    fn validate_locked(&self, vm: &KvmVm, cores: &[MutexGuard<'_, NativeCore>]) -> Result<()> {
+        if self.version != 4
+            || self.cpus.len() != cores.len()
+            || self.deferred.len() != cores.len()
+            || self.terminal.len() != cores.len()
+            || self.cpus.is_empty()
+            || self
+                .cpus
+                .iter()
+                .zip(cores)
+                .any(|(saved, target)| saved.id != target.id)
+        {
+            return Err(invalid("version or CPU identity set differs"));
+        }
+        let irqchip = vm.memory.irqchip_created.load(Ordering::Acquire);
+        if self.shared.is_some() != irqchip {
+            return Err(invalid("shared controller profile differs"));
+        }
+        if let Some(shared) = &self.shared {
+            shared.validate()?;
+        }
+        for result in self.deferred.iter().flatten() {
+            result.validate()?;
+        }
+        if !self.powered_off && self.terminal.iter().any(Option::is_some) {
+            return Err(invalid("native I/O records require VM-wide power-off"));
+        }
+        for result in self.terminal.iter().flatten() {
+            result.restore().map_err(invalid)?;
+        }
+        if !self.powered_off && cores.iter().any(|core| core.native_io_unsettled) {
+            return Err(invalid(
+                "active restore requires a fresh native owner after terminal I/O",
+            ));
+        }
+        for core in cores {
+            ready(core)?;
+        }
+        for (image, core) in self.cpus.iter().zip(cores) {
+            image.validate(
+                &vm.memory.checkpoint_kvm,
+                &vm.memory.vm_fd,
+                &core.vcpu_fd,
+                core.id,
+                &core.configured_cpuid,
+                irqchip,
+            )?;
+        }
+        let descriptors: Vec<_> = cores.iter().map(|cpu| (cpu.id, &cpu.vcpu_fd)).collect();
+        self.clock
+            .validate_target(&descriptors, native_rate(cores)?)
+            .map_err(invalid)
+    }
+
+    /// Resolve all profile/identity admission before the enclosing producer
+    /// installs any CPU, device or physical memory state.
+    pub(in crate::backend::kvm) fn validate_target(
+        &self,
+        vm: &KvmVm,
+        boundary: &CheckpointBoundary<'_>,
+    ) -> Result<()> {
+        let handles = vm.checkpoint_cpu_handles(boundary)?;
+        self.validate_locked(vm, &lock_cpus(vm, &handles)?)
+    }
+
+    /// Install stored banks on a disposable graph or inside the complete
+    /// producer's rollback transaction. This deliberately does not rebase the
+    /// clocks or activate entry before shared state and RAM are installed.
+    pub(in crate::backend::kvm) fn restore_stored(
+        &self,
+        vm: &KvmVm,
+        boundary: &CheckpointBoundary<'_>,
+    ) -> Result<()> {
+        let handles = vm.checkpoint_cpu_handles(boundary)?;
+        let mut cores = lock_cpus(vm, &handles)?;
+        self.validate_locked(vm, &cores)?;
+        // Own and validate every result before the first native setter. The
+        // destination queue is replaced only after all native banks succeed.
+        let deferred = self
+            .deferred
+            .iter()
+            .map(|result| result.as_ref().map(deferred::Image::restore).transpose())
+            .collect::<Result<Vec<_>>>()?;
+        let terminal = self
+            .terminal
+            .iter()
+            .map(|result| {
+                result
+                    .as_ref()
+                    .map(super::super::io::TerminalImage::restore)
+                    .transpose()
+                    .map_err(invalid)
+            })
+            .collect::<Result<Vec<_>>>()?;
+        let irqchip = vm.memory.irqchip_created.load(Ordering::Acquire);
+        if let Some(shared) = &self.shared {
+            let mut lines = vm
+                .memory
+                .irq_lines
+                .lock()
+                .map_err(|_| invalid("IRQ line ownership lock poisoned"))?;
+            shared.restore_lines(&vm.memory.vm_fd, &mut lines)?;
+        }
+        for (image, core) in self.cpus.iter().zip(&mut cores) {
+            let core = &mut **core;
+            image.restore_stored(
+                &vm.memory.checkpoint_kvm,
+                &vm.memory.vm_fd,
+                &mut core.vcpu_fd,
+                core.id,
+                &core.configured_cpuid,
+                irqchip,
+            )?;
+            core.userspace_halted = image.userspace_halted;
+        }
+        if let Some(shared) = &self.shared {
+            shared.restore_controllers(&vm.memory.vm_fd)?;
+        }
+        for ((core, result), terminal) in cores.iter_mut().zip(deferred).zip(terminal) {
+            core.deferred_exit = result;
+            core.io = terminal.unwrap_or_default();
+            // Terminal records retain owned bytes only. They never import a
+            // pointer into the source run mapping or authorize native entry.
+            core.pending_io_in = None;
+        }
+        vm.memory
+            .powered_off
+            .store(self.powered_off, Ordering::Release);
+        Ok(())
+    }
+
+    /// Complete the common unscaled clock sample under real VM exclusion.
+    /// The enclosing producer must call this at its actual first-entry gate;
+    /// calling it early would include stopped RAM-publication time as runtime.
+    pub(in crate::backend::kvm) fn rebase_clock(
+        &self,
+        vm: &KvmVm,
+        boundary: &CheckpointBoundary<'_>,
+    ) -> Result<()> {
+        let handles = vm.checkpoint_cpu_handles(boundary)?;
+        let cores = lock_cpus(vm, &handles)?;
+        self.validate_locked(vm, &cores)?;
+        let descriptors: Vec<_> = cores.iter().map(|cpu| (cpu.id, &cpu.vcpu_fd)).collect();
+        self.clock
+            .restore_at_resume(&vm.memory.vm_fd, &descriptors, native_rate(&cores)?)
+            .map_err(invalid)?;
+        Ok(())
+    }
+
+    /// Arm the common first-entry gate after installing the CPU banks. The
+    /// enclosing producer retains exclusion through all RAM/device publication.
+    /// No native clock setter runs here, and another stopped capture preserves
+    /// this canonical phase until managed guest entry consumes it.
+    pub(in crate::backend::kvm) fn stage_resume_clock(
+        &self,
+        vm: &KvmVm,
+        boundary: &CheckpointBoundary<'_>,
+    ) -> Result<()> {
+        self.stage_clock(vm, boundary, None)
+    }
+
+    /// Couple the retained software-device clock to this native epoch. The
+    /// incoming phase stays frozen until actual guest entry, including across
+    /// HLT polling, readiness probes and a second stopped checkpoint capture.
+    pub(in crate::backend::kvm) fn stage_resume_clock_with_timing(
+        &self,
+        vm: &KvmVm,
+        boundary: &CheckpointBoundary<'_>,
+        timing: Arc<crate::vm::timing::TimingContext>,
+        state: crate::vm::timing::ClockState,
+    ) -> Result<()> {
+        self.stage_clock(vm, boundary, Some((timing, state)))
+    }
+
+    fn stage_clock(
+        &self,
+        vm: &KvmVm,
+        boundary: &CheckpointBoundary<'_>,
+        devices: Option<(
+            Arc<crate::vm::timing::TimingContext>,
+            crate::vm::timing::ClockState,
+        )>,
+    ) -> Result<()> {
+        self.validate_target(vm, boundary)?;
+        let prepared = devices
+            .as_ref()
+            .map(|(timing, state)| timing.prepare_stopped_checkpoint_state(state))
+            .transpose()?;
+        let mut pending = vm
+            .memory
+            .resume_clock
+            .lock()
+            .map_err(|_| invalid("native resume clock lock poisoned"))?;
+        if let Some(previous) = &*pending {
+            previous.validate_device_owner(devices.as_ref().map(|(owner, _)| owner))?;
+        }
+        // All fallible admission precedes publication. The stopped VM boundary
+        // excludes entry while both clock owners acquire the canonical phase.
+        if let Some(prepared) = prepared {
+            prepared.commit();
+        }
+        *pending = Some(crate::backend::kvm::clock_gate::PendingClock {
+            native: self.clock.clone(),
+            devices: devices.map(|(owner, state)| (owner, state.elapsed_nanos)),
+        });
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+#[path = "owner_tests.rs"]
+mod tests;
