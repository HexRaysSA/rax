      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "anchor": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "object_generation": {
          "$ref": "#/$defs/u64"
        },
        "complete_owner": {
          "$ref": "#/$defs/name"
        },
        "stage": {
          "enum": [
            "constructing",
            "published"
          ]
        }
      },
      "required": [
