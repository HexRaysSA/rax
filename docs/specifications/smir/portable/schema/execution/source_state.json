{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rax:smir:execution:source-state:unbound-draft:1",
  "$comment": "Independent conditional model only. Labels/ranges/schedules are hypotheses; no original source fact, runtime permit, execution admission or active SMIR version/ID is issued.",
  "type": "object",
  "properties": {
    "format": {
      "const": "conditional-source-state"
    },
    "revision": {
      "const": 1
    },
    "binding": {
      "const": "unbound"
    },
    "original_source_binding": {
      "const": "unresolved"
    },
    "runtime_authority": {
      "const": false
    },
    "source_fact_authority": {
      "const": false
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      },
      "maxItems": 4096
    },
    "schedules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/schedule"
      },
      "maxItems": 4096
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pattern"
      },
      "maxItems": 4096
    },
    "initialization": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history"
      },
      "maxItems": 4096
    },
    "current": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/range"
      },
      "maxItems": 4096
    },
    "ended": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/range"
      },
      "maxItems": 4096
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "maxItems": 4096
    }
  },
