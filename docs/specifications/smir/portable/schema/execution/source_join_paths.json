{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rax:smir:execution:source-join-paths:unbound-draft:1",
  "type": "object",
  "properties": {
    "format": {
      "const": "conditional-source-join-paths"
    },
    "revision": {
      "const": 1
    },
    "binding": {
      "const": "unbound"
    },
    "runtime_authority": {
      "const": false
    },
    "source_fact_authority": {
      "const": false
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      },
      "maxItems": 256,
      "minItems": 1
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      },
      "maxItems": 4096
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      },
      "maxItems": 4096
    }
  },
  "required": [
    "format",
    "revision",
    "binding",
    "runtime_authority",
    "source_fact_authority",
    "contexts",
    "programs",
    "cells"
  ],
  "additionalProperties": false,
  "$defs": {
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967294
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "maxLength": 4096
    },
    "qref": {
      "type": "object",
      "properties": {
        "module": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "self"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "dependency"
                },
                "slot": {
                  "$ref": "#/$defs/u32"
                }
              },
              "required": [
                "kind",
                "slot"
              ],
              "additionalProperties": false
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/u32"
        }
      },
      "required": [
        "module",
        "id"
      ],
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "abi_major": {
          "$ref": "#/$defs/u32"
        }
      },
      "required": [
        "namespace",
        "name",
        "abi_major"
      ],
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "properties": {
        "section": {
          "$ref": "#/$defs/u32"
        },
        "digest": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "section",
        "digest"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "abi_context": {
          "$ref": "#/$defs/u32"
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "abi_site": {
          "$ref": "#/$defs/hash"
        },
        "schema_digest": {
          "$ref": "#/$defs/hash"
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/root"
          },
          "maxItems": 10
        }
      },
      "required": [
        "id",
        "abi_context",
        "family",
        "abi_site",
        "schema_digest",
        "roots"
      ],
      "additionalProperties": false
    },
    "program": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "context": {
          "$ref": "#/$defs/name"
        },
        "abi_cleanup": {
          "$ref": "#/$defs/u32"
        },
        "original_journal": {
          "$ref": "#/$defs/qref"
        },
        "source_class": {
          "$ref": "#/$defs/qref"
        },
        "view": {
          "enum": [
            "complete",
            "nonvirtual"
          ]
        },
        "cleanup_signature": {
          "$ref": "#/$defs/qref"
        }
      },
      "required": [
        "id",
        "context",
        "abi_cleanup",
        "original_journal",
        "source_class",
        "view",
        "cleanup_signature"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "first": {
          "$ref": "#/$defs/u64"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "first",
        "count"
      ],
      "additionalProperties": false
    },
    "step": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "member"
            },
            "declaration_index": {
              "$ref": "#/$defs/u32"
            }
          },
          "required": [
            "kind",
            "declaration_index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "base"
            },
            "declaration_index": {
              "$ref": "#/$defs/u32"
            },
            "virtual": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "declaration_index",
            "virtual"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "element"
            },
            "selection": {
              "$ref": "#/$defs/selection"
            }
          },
          "required": [
            "kind",
            "selection"
          ],
          "additionalProperties": false
        }
      ]
    },
    "route": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "selector": {
      "type": "object",
      "properties": {
        "declared_leaf": {
          "$ref": "#/$defs/qref"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          },
          "minItems": 1,
          "maxItems": 4096
        }
      },
      "required": [
        "declared_leaf",
        "routes"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "offset_constant_bits": {
          "$ref": "#/$defs/u64"
        },
        "offset_coefficients_bits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/u64"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "width_bits": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "offset_constant_bits",
        "offset_coefficients_bits",
        "width_bits"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "anchor"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "observe"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "whole_slot"
            },
            "slot": {
              "$ref": "#/$defs/u32"
            }
          },
          "required": [
            "kind",
            "slot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "slot_elements"
            },
            "slot": {
              "$ref": "#/$defs/u32"
            }
          },
          "required": [
            "kind",
            "slot"
          ],
          "additionalProperties": false
        }
      ]
    },
    "cell": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "program": {
          "$ref": "#/$defs/name"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "leaf_view": {
          "enum": [
            "complete",
            "nonvirtual"
          ]
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      },
      "required": [
        "id",
        "program",
        "selector",
        "leaf_view",
        "geometry",
        "coverage"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Static canonical source requirements with exact symbolic cleanup coverage; no source/runtime authority."
}
