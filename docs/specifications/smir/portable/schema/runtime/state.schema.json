                    },
                    "required": [
                      "block",
                      "next_operation",
                      "predecessor"
                    ],
                    "additionalProperties": false
                  },
                  "results": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "maxItems": 256
                  }
                },
                "required": [
                  "activation",
                  "position",
                  "results"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "unwind": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "activation": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "block": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "next_operation": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "predecessor": {
                        "oneOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4294967295
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "block",
                      "next_operation",
                      "predecessor"
                    ],
                    "additionalProperties": false
                  },
                  "results": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "maxItems": 256
                  }
                },
                "required": [
                  "activation",
                  "position",
                  "results"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "exception": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              {
                "type": "null"
              }
            ]
          },
          "ticket": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "sequence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "operation": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "normal": {
                    "type": "object",
                    "properties": {
                      "block": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "next_operation": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "predecessor": {
                        "oneOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4294967295
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "block",
                      "next_operation",
                      "predecessor"
