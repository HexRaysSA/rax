                    "properties": {
                      "block": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "next_operation": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "predecessor": {
                        "oneOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4294967295
                          },
                          {
                            "type": "null"
