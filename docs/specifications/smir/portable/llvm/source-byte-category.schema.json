        "kind": {
          "enum": [
            "var",
            "parameter",
            "field",
            "typedef",
            "enum"
          ]
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": [
        "file",
        "offset",
        "file_sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967294
        },
        "file_sha256": {
          "type": "string",
