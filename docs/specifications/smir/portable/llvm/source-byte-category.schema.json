  "required": [
    "format",
    "revision",
    "binding",
    "source_fact_authority",
    "semantic_admission",
    "runtime_authority",
    "llvm_pin",
    "oracle",
    "bundle",
    "frontend",
    "options",
    "inputs",
    "language",
    "recipe_profile",
    "rows"
