    "source_fact_authority": {
      "const": false
    },
    "semantic_admission": {
      "const": false
    },
    "runtime_authority": {
      "const": false
    },
    "llvm_pin": {
      "const": "36763294ef639d8a6a4379d81da653dda1c20686"
    },
    "oracle": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frontend": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "options": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "language": {
      "enum": [
        "c23",
        "cpp23"
      ]
    },
    "recipe_profile": {
      "const": "lp64-ast-surrogate-v1"
