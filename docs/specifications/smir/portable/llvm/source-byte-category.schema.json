        },
        "canonical_kind": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "char",
            "signed_char",
            "unsigned_char",
            "char8_t",
            "std_byte",
            "numeric",
            "unsupported"
